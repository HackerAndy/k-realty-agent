__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.env
.DS_Store
.secrets/
.browser_profiles/
data/
*.pdf
_googleEmail/
!tests/fixtures/*.pdf
# Financial source documents (bank/statement exports) — never commit real data.
# The earlier patterns were missing the ".", so they matched nothing.
*.csv
!tests/fixtures/*.csv

# Coverage data written by the code-gen gate (orchestration/verify.py)
.coverage*

# Codegen bench output — logs, and the parsers the agent wrote during a run.
# Scratch for diagnosis; headline numbers belong in docs/agent-harvest-plan.md.
orchestration/bench/results/

# Agent worktrees — full working copies of this repo (hundreds of MB), created
# per background task. The skills beside them (.claude/skills) ARE tracked.
.claude/worktrees/

# Frontend (frontend/) build tooling and output — frontend/src/ is the source
# of truth; interfaces/web/dist/ is generated by `npm run build` and served by
# rest_server.py, same as any other build artifact.
frontend/node_modules/
interfaces/web/dist/

# Electron desktop shell
desktop/node_modules/
desktop/dist/
desktop/out/
